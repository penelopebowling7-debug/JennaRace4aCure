rules_version = '2';

// Racing for a Cure Event HQ — Firestore security rules
//
// The planning pages (Overview, Money Raised, Attendees, Donations,
// Activities, Checklist) require sign-in AND an approved email, same as
// before. The public register-tickets.html page is the one exception:
// anyone with the link can submit their contact details and a ticket
// request without signing in, which lands as a new attendee for an
// approved editor to see.
//
// Three tiers of access, all stored on config/access:
//  - emails: everyone who can sign in and use the planning pages at all.
//  - paymentAdmins: a subset of emails who can additionally mark a guest as
//    paid, or touch an already-paid record, since that's the person
//    reconciling against the real bank account.
//  - siteAdmins: a subset of emails who control BOTH of the lists above.
//    Nobody else, including payment admins, can change who's approved or
//    who's a payment admin, only a site admin can. There is deliberately no
//    in-app way to grant siteAdmins itself beyond the one-time bootstrap/
//    migration below, that's a rare enough change to do by hand in the
//    Firebase console if it's ever needed.
//
// The very first person to ever sign in becomes the first approved editor,
// first payment admin AND first site admin automatically, so there is no
// manual Firestore console step needed to bootstrap a brand new project.
//
// Paste this whole file into: Firebase console -> Firestore Database ->
// Rules tab -> replace everything -> Publish. See README.md for the full
// walkthrough.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function accessDoc() {
      return get(/databases/$(database)/documents/config/access).data;
    }

    function isApproved() {
      return signedIn() && request.auth.token.email in accessDoc().emails;
    }

    function isPaymentAdmin() {
      return signedIn() && request.auth.token.email in accessDoc().paymentAdmins;
    }

    function isSiteAdmin() {
      return signedIn() && request.auth.token.email in accessDoc().siteAdmins;
    }

    // Anyone signed in can read the access list (so the app can tell them
    // "you're not approved yet"). The document can be CREATED by a
    // signed-in user only while it doesn't exist yet, seeding themselves as
    // the sole approved editor, payment admin AND site admin, that's what
    // lets the very first person in with no admin step.
    //
    // After that, only a site admin can change any of the three lists. The
    // two "one-time migration" clauses below exist only for a project that
    // was set up before paymentAdmins/siteAdmins existed: each lets any
    // approved editor seed that one list exactly once, only while it has
    // never been set. The moment a list is set, its clause can never fire
    // again, so it can't be used to re-grant access later.
    match /config/access {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/config/access)
        && request.resource.data.emails is list
        && request.resource.data.emails.size() == 1
        && request.resource.data.emails[0] == request.auth.token.email
        && request.resource.data.paymentAdmins is list
        && request.resource.data.paymentAdmins.size() == 1
        && request.resource.data.paymentAdmins[0] == request.auth.token.email
        && request.resource.data.siteAdmins is list
        && request.resource.data.siteAdmins.size() == 1
        && request.resource.data.siteAdmins[0] == request.auth.token.email;
      allow update: if isApproved()
        && (isSiteAdmin()
            || (!('paymentAdmins' in resource.data)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentAdmins'])
                && request.resource.data.paymentAdmins is list
                && request.resource.data.paymentAdmins.size() > 0
                && request.resource.data.paymentAdmins[0] == request.auth.token.email)
            || (!('siteAdmins' in resource.data)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['siteAdmins'])
                && request.resource.data.siteAdmins is list
                && request.resource.data.siteAdmins.size() > 0
                && request.resource.data.siteAdmins[0] == request.auth.token.email));
    }

    // Public settings are safe to expose read-only with no login, so the
    // public register page can show the live event name, date and ticket
    // price. Nothing sensitive lives in this collection.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isApproved();
    }

    // A public ticket-request create is only valid if it looks exactly like
    // an unpaid, self-registered guest: fixed set of fields, "invited"
    // status, zero amount paid. It can never read, update or delete
    // anything, and it can never create an already-paid record.
    function isValidPublicTicketRequest() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'name', 'email', 'phone', 'tickets', 'status', 'amountPaid', 'notes', 'dateAdded'])
        && d.name is string && d.name.size() > 0 && d.name.size() < 200
        && d.email is string && d.email.size() < 200
        && d.phone is string && d.phone.size() < 60
        && d.tickets is int && d.tickets > 0 && d.tickets <= 20
        && d.status == 'invited'
        && d.amountPaid == 0
        && d.notes is string && d.notes.size() < 500
        && d.dateAdded is string;
    }

    match /attendees/{docId} {
      allow read: if isApproved();
      allow create: if isValidPublicTicketRequest()
        || (isApproved() && (isPaymentAdmin() || request.resource.data.status != 'paid'));
      allow update: if isApproved()
        && (isPaymentAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'amountPaid']));
      allow delete: if isApproved();
    }

    match /donations/{docId} {
      allow read, write: if isApproved();
    }

    match /activities/{docId} {
      allow read, write: if isApproved();
    }

    match /checklist/{docId} {
      allow read, write: if isApproved();
    }

    match /manualFunds/{docId} {
      allow read, write: if isApproved();
    }

    match /emailTemplates/{docId} {
      allow read, write: if isApproved();
    }
  }
}
